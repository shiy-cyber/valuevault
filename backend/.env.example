# Copia este fichero a .env y rellena los valores
ALPHA_VANTAGE_KEY=tu_clave_alpha_vantage
PORT=3001
CORS_ORIGIN=*

# Narrativa IA de CapEx ("¿en qué invierte?"). Requerida para el botón IA.
ANTHROPIC_API_KEY=tu_clave_anthropic
# Opcional: modelo. Por defecto claude-haiku-4-5 (barato, ~$0,05/narrativa).
# Sube a claude-opus-4-8 si quieres máxima calidad (~$0,10-0,15/narrativa).
# CAPEX_AI_MODEL=claude-haiku-4-5

# Recuperación de contraseña por email (Resend). Sin ella, el envío se omite
# silenciosamente (avisa por log) y el código de recuperación sigue funcionando.
RESEND_API_KEY=tu_clave_resend
RESEND_FROM_EMAIL=ValueVault <no-reply@valuevault.es>

# Forward P/E histórico (Evolución de Valoración): respaldo cuando Alpha
# Vantage EARNINGS_ESTIMATES no tiene cobertura para un ticker. Opcional —
# sin ella, esos tickers concretos simplemente no muestran Fwd P/E.
FMP_API_KEY=tu_clave_financialmodelingprep
